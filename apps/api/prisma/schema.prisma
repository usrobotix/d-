generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  eyebrow     String
  title       String
  description String
  forWho      String
  includes    Json
  steps       Json
  tiers       Json
  priceNote   String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  seoKeywords String?
  ogImage     String?
  focusKey    String?
  canonical   String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Case {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  h1             String
  sub            String
  tags           String[]
  year           Int
  term           String?
  client         String?
  direction      String
  isFeatured     Boolean   @default(false)
  cover          String?
  gallery        Json?
  stack          String[]
  taskText       String    @db.Text
  solutionItems  String[]
  resultMetrics  Json
  closingText    String?   @db.Text
  sortOrder      Int       @default(0)
  status         String    @default("published")
  seoTitle       String?
  seoDesc        String?
  ogImage        String?
  focusKey       String?
  canonical      String?
  noindex        Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
}

model FaqCategory {
  id        Int       @id @default(autoincrement())
  title     String
  icon      String?
  sortOrder Int       @default(0)
  items     FaqItem[]
}

model FaqItem {
  id         Int         @id @default(autoincrement())
  question   String
  answer     String      @db.Text
  category   FaqCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  sortOrder  Int         @default(0)
  published  Boolean     @default(true)
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  type       String
  image      String?
  company    String?
  year       Int?
  quote      String?  @db.Text
  authorName String?
  authorRole String?
  avatar     String?
  rating     Int?
  poster     String?
  videoUrl   String?
  gridSize   String?
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
}

model Lead {
  id         Int      @id @default(autoincrement())
  name       String
  contact    String
  service    String?
  message    String?  @db.Text
  sourcePage String?
  utm        Json?
  status     String   @default("new")
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  thumbUrl  String?
  alt       String?
  width     Int?
  height    Int?
  size      Int?
  mimeType  String
  createdAt DateTime @default(now())
}

model Settings {
  id    String @id
  value String @db.Text
}

model Redirect {
  id        Int      @id @default(autoincrement())
  from      String   @unique
  to        String
  code      Int      @default(301)
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("editor")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  entity    String
  entityId  Int?
  action    String
  diff      Json?
  createdAt DateTime @default(now())
}
